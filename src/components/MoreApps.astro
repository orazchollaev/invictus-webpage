---
interface Props {
	name: string;
	text: string;
	href: string;
	logo: string;
}

const { name, text, href, logo } = Astro.props;
---

<section class="wrap" aria-label="Another app from Invictus">
	<a class="other-app" href={href}>
		<img src={logo} alt="" width="56" height="56" loading="lazy" />
		<span>
			<strong>{name}</strong>
			{text}
		</span>
	</a>
</section>
