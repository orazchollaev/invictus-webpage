---
interface Props {
	current: 'tournament-maker' | 'national-manager';
}

const { current } = Astro.props;

const apps = [
	{ id: 'tournament-maker', label: 'Tournament Maker', href: '/', icon: '/favicon.svg' },
	{ id: 'national-manager', label: 'National Manager', href: '/national-manager/', icon: '/national-manager/logo.png' },
];
---

<header class="site-nav">
	<a class="site-nav-brand" href="/">Invictus</a>
	<nav aria-label="Invictus apps">
		{
			apps.map((app) => (
				<a
					class:list={['site-nav-link', { active: app.id === current }]}
					href={app.href}
					aria-current={app.id === current ? 'page' : undefined}
				>
					<img src={app.icon} alt="" width="22" height="22" />
					<span>{app.label}</span>
				</a>
			))
		}
	</nav>
</header>
