---
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	favicon?: string;
	image?: string;
	current?: 'tournament-maker' | 'national-manager';
}

const { title, description, favicon = '/favicon.svg', image, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#f2f3ef" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f1312" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
		<meta name="google-site-verification" content="DWdEqOuGtj1rPyzeENXiHw1RMuZ7YZcCUbj69frFhJA" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<SiteNav current={current} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
		<script>
			const nav = document.querySelector('.nav');
			const update = () => nav?.toggleAttribute('data-scrolled', window.scrollY > 8);
			update();
			window.addEventListener('scroll', update, { passive: true });
		</script>
	</body>
</html>
