---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';

const email = 'orazchollaev@gmail.com';
const subject = encodeURIComponent('Invictus data deletion request');

const steps = [
	{
		title: 'Email us from your Google account',
		text: 'Send a deletion request from the email address of the Google account you signed in with, or tell us that address in the message. Use the button below.',
	},
	{
		title: 'We delete your account and shared content',
		text: 'We delete your Invictus account together with everything linked to it, including datasets you shared, and confirm by email within 30 days.',
	},
	{
		title: 'Clear data on your device (optional)',
		text: 'Open Android Settings, go to Apps, choose the Invictus app, tap Storage and then Clear data, or uninstall the app. This removes tournaments, teams and settings stored locally.',
	},
];

const data = [
	{
		title: 'Account data (Google sign-in)',
		text: 'When you sign in with Google we store your Google account ID, name, email address and profile photo through Firebase Authentication. Kept until you ask us to delete the account, then erased within 30 days.',
	},
	{
		title: 'Content you share',
		text: 'Datasets (teams and players) you publish to the market, with their name, description and your account ID. Deleted together with your account. Copies other users already saved on their own devices stay on those devices.',
	},
	{
		title: 'Stored on your device only',
		text: 'Tournaments, results, save slots, language and settings never leave your device. Clearing app data or uninstalling deletes them for good.',
	},
	{
		title: 'Usage analytics',
		text: 'Anonymous app events through Firebase Analytics, tied to a random app instance ID. Retained by Google Analytics for up to 14 months, then deleted automatically.',
	},
	{
		title: 'Push token and advertising ID',
		text: 'A Firebase Cloud Messaging token for notifications is invalidated when you uninstall the app. Google AdMob may use your advertising ID, which you can reset or delete in Android Settings under Google, Ads.',
	},
];
---

<Layout
	title="Delete your data | Invictus"
	description="How to delete your Invictus account and data, including your Google sign-in details and shared datasets."
>
	<SiteNav current="tournament-maker" />

	<header class="page-head">
		<h1>Delete your Invictus data</h1>
		<p>Applies to Invictus Tournament Maker and Invictus National Manager (developer: Oraz Chollaev).</p>
	</header>

	<section class="section">
		<h2>Your account and your data</h2>
		<p class="section-lead">
			Invictus Tournament Maker lets you sign in with Google to share and download datasets. Invictus National Manager has no
			accounts: its saves stay on your device. Request deletion below to remove your account and the data linked to it.
		</p>
	</section>

	<section class="section section-alt">
		<h2>How to request deletion</h2>
		<div class="grid grid-3">
			{
				steps.map((s, i) => (
					<div class="card card-compact">
						<h3>
							{i + 1}. {s.title}
						</h3>
						<p>{s.text}</p>
					</div>
				))
			}
		</div>
		<p class="cta-text mail">
			<a class="cta cta-large" href={`mailto:${email}?subject=${subject}`}>Email {email}</a>
		</p>
		<p class="cta-text">We reply within 30 days and delete the data you ask about.</p>
	</section>

	<section class="section">
		<h2>What is stored and for how long</h2>
		<div class="grid grid-3">
			{
				data.map((d) => (
					<div class="card card-compact">
						<h3>{d.title}</h3>
						<p>{d.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<footer class="footer">
		<span>Invictus</span>
		<span>&copy; {new Date().getFullYear()}</span>
	</footer>
</Layout>

<style>
	.page-head {
		background: #0b7264;
		color: #eceeea;
		text-align: center;
		padding: 4.5rem 6vw 4rem;
	}
	.page-head h1 {
		color: #eceeea;
		text-align: center;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
	}
	.page-head p {
		max-width: 60ch;
		margin: 1rem auto 0;
		font-size: 1.05rem;
		line-height: 1.6;
		opacity: 0.9;
	}
	.section-alt .cta-text {
		text-align: center;
	}
	.mail {
		margin-top: 2.5rem;
	}
</style>
