---
import Layout from '../layouts/Layout.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.orazchollaev.invictustournamentmaker';
---

<Layout>
	<main class="hero">
		<div class="panel panel-primary">
			<div class="panel-primary-content">
				<p class="description">
					Invictus Tournament Maker <br/> build and run your own football (soccer) tournaments, leagues, and knockout brackets, right from your phone.				</p>
				<a class="cta" href={playStoreUrl}>
					<img src="/google-play-store-icon.webp" alt="" width="20" height="20" />
					Get it on Google Play
				</a>
			</div>
		</div>

		<div class="panel panel-brand">
			<div class="brand-row">
				<img class="brand-mark" src="/favicon.svg" alt="" />
				<h1>Invictus <span>Tournament Maker</span></h1>
			</div>
			<img class="bracket-shot" src="/bracket.png" alt="Invictus bracket screen" />
		</div>
	</main>
</Layout>

<style>
	:global(html),
	:global(body) {
		background: #eceeea;
	}

	.hero {
		position: relative;
		height: 100dvh;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		overflow: hidden;
		background: #eceeea;
	}

	.panel {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.panel-primary {
		position: relative;
		background: #0b7264;
		clip-path: polygon(0 0, 100% 0, 74% 100%, 0 100%);
		margin-right: -10vw;
		z-index: 2;
		overflow: hidden;
	}

	.panel-primary-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 50ch;
		padding: 0 5vw 0 5vw;
		margin-right: 10vw;
	}


	.description {
		margin: 0 0 2.25rem;
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.5;
		color: #eceeea;
		text-align: center;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.9rem 1.6rem;
		border-radius: 6px;
		background: #eceeea;
		color: #0b7264;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.cta:hover {
		background: #d8dcd6;
		transform: translateY(-1px);
	}

	.cta:focus-visible {
		outline: 2px solid #eceeea;
		outline-offset: 3px;
	}

	.panel-brand {
		flex-direction: column;
		background: #eceeea;
		gap: 1.5rem;
		padding: 3vh 4vw 4vh 6vw;
	}

	.brand-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.brand-mark {
		width: 50px;
		height: 50px;
	}

	h1 {
		margin: 0;
		font-weight: 700;
		font-size: clamp(1.3rem, 1.8vw, 1.6rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: #1e211f;
		text-align: left;
	}

	h1 span {
		display: block;
		font-weight: 500;
		font-size: 0.6em;
		letter-spacing: 0.03em;
		color: #5b6b66;
	}

	.bracket-shot {
		width: 100%;
		max-width: 480px;
		max-height: 58dvh;
		object-fit: contain;
		object-position: top;
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			grid-template-rows: 65% 35%;
		}

		.panel-primary {
			clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%);
			margin-right: 0;
			margin-top: -10vh;
			order: 2;
		}

		.description{
			font-size: 1.2rem;
			margin-bottom: 1rem;
		}

		.panel-primary-content {
			margin-right: 0;
			margin-top: 10vh;
			padding: 0 6vw;
		}

		.panel-brand {
			order: 1;
			padding: 2vh 6vw 3vh;
		}

		.brand-row {
			text-align: start;
		}

		.bracket-shot {
			max-height: 34dvh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta {
			transition: none;
		}
	}
</style>
