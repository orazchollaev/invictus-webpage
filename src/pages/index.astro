---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import MoreApps from '../components/MoreApps.astro';

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.orazchollaev.invictustournamentmaker';

const formats = [
	{
		title: 'Knockout',
		text: 'Single-elimination bracket with one or two-legged ties, aggregate scoring, penalty shootouts, and an optional third-place match.',
	},
	{
		title: 'Group + Knockout',
		text: 'Round-robin groups feed a knockout bracket, with automatic cross-seeding, wildcards, and no-rematch or random draw modes.',
	},
	{
		title: 'League',
		text: 'Full or half-length round-robin season, up to 10 tiers with promotion and relegation, plus an optional playoff to crown a champion.',
	},
	{
		title: 'Swiss',
		text: 'Champions League–style format: fixed rounds against opponents matched by standing, then the top finishers advance to a knockout.',
	},
];

const playStyles = [
	{
		title: 'Simulate',
		text: 'Fill in scores yourself, or simulate a match, a matchday, or the whole tournament based on each team’s power rating. Tune Surprise Factor, Home Advantage, and Form to change how predictable results are.',
	},
	{
		title: 'Watch it live',
		text: 'Play matches out minute by minute with goals, shots, xG, cards, injuries, and substitutions. Ties go to real extra time and a kick-by-kick penalty shootout.',
	},
	{
		title: 'Manage a team',
		text: 'Pick a team and run its season yourself: set formation and play style, choose your XI — or let the app auto-pick — and make live substitutions.',
	},
];

const features = [
	{ title: 'Teams & players', text: 'Build rosters with colors, power ratings, and coaches; bulk-generate players from an editable name pool.' },
	{ title: 'Multiple seasons', text: 'Run it back with New Season — random, seeded, or manual draws, with every season kept.' },
	{ title: 'History & stats', text: 'Champions, all-time tables, biggest wins, title streaks, and per-team records across every season.' },
	{ title: '15 languages', text: 'English, Turkish, German, French, Arabic, Spanish, Portuguese, Russian, Japanese, Korean, Thai, Vietnamese, Polish, Indonesian, Hindi.' },
	{ title: 'Themes', text: 'Light, Dark, or a World Cup 2026 theme, with Classic or Double-Sided bracket layouts.' },
	{ title: 'Export & import', text: 'Save all your teams and tournaments to a file and restore them anytime.' },
];
---

<Layout
	title="Invictus - Tournament Maker"
	description="Invictus Tournament Maker — build knockouts, groups, leagues and Swiss-style football tournaments, simulate or play matches live, and track history across seasons. Free on Google Play."
	image="/bracket.png"
>
	<SiteNav current="tournament-maker" />

	<main class="hero">
		<div class="panel panel-primary">
			<div class="panel-primary-content">
				<p class="description">
					Invictus Tournament Maker <br /> build and run your own football (soccer) tournaments, leagues, and knockout
					brackets, right from your phone.
				</p>
				<a class="cta" href={playStoreUrl}>
					<img src="/google-play-store-icon.webp" alt="" width="20" height="20" />
					Get it on Google Play
				</a>
			</div>
		</div>

		<div class="panel panel-brand">
			<div class="brand-row">
				<img class="brand-mark" src="/favicon.svg" alt="" />
				<h1>Invictus <span>Tournament Maker</span></h1>
			</div>
			<img class="bracket-shot" src="/bracket.png" alt="Invictus bracket screen" />
		</div>
	</main>

	<section class="section">
		<h2>One app, four tournament formats</h2>
		<div class="grid grid-4">
			{
				formats.map((f) => (
					<div class="card">
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section section-alt">
		<h2>Play it your way</h2>
		<div class="grid grid-3">
			{
				playStyles.map((p) => (
					<div class="card">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<h2>Everything you need to run a competition</h2>
		<div class="grid grid-3">
			{
				features.map((f) => (
					<div class="card card-compact">
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section section-alt cta-section">
		<h2>Free on Android — and works in your browser too</h2>
		<p class="cta-text">All data is stored locally and survives page refreshes. No account needed.</p>
		<a class="cta cta-large" href={playStoreUrl}>
			<img src="/google-play-store-icon.webp" alt="" width="22" height="22" />
			Get it on Google Play
		</a>
	</section>

	<MoreApps
		name="Invictus National Manager"
		text="Take charge of any of the 211 FIFA nations and lead them through qualifiers, continental cups and the World Cup."
		href="/national-manager/"
		logo="/national-manager/logo.png"
	/>

	<footer class="footer">
		<span>Invictus Tournament Maker</span>
		<span>&copy; {new Date().getFullYear()}</span>
	</footer>
</Layout>
