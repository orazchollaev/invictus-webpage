---
import Layout from '../layouts/Layout.astro';
import MoreApps from '../components/MoreApps.astro';
import Phone from '../components/Phone.astro';
import PlayButton from '../components/PlayButton.astro';

const webAppUrl = 'https://invictus-national-manager.vercel.app/';

const journey = [
	{
		title: 'Pick any nation',
		text: 'All 211 FIFA members are open, from Spain to San Marino, seeded from the real FIFA ranking with their own players.',
	},
	{
		title: 'Call up your squad',
		text: 'Name a squad for every international window and tournament, or let your assistant pick it. Injuries, form and suspensions all count.',
	},
	{
		title: 'Set your tactics',
		text: 'Choose from ten formations, pick your eleven and set mentality, tempo and pressing for each match.',
	},
	{
		title: 'Play every minute',
		text: 'Follow live commentary with shots, xG, cards, injuries and substitutions, through extra time and kick-by-kick shootouts.',
	},
];

const screens = [
	{
		src: '/national-manager/screen-nations.webp',
		title: 'Every FIFA member',
		text: 'Choose your nation by confederation, sorted by world ranking.',
	},
	{
		src: '/national-manager/screen-tactics.webp',
		title: 'Your eleven, your way',
		text: 'Line up your players in ten formations, or let Best XI suggest a side.',
	},
	{
		src: '/national-manager/screen-comps.webp',
		title: 'The full international calendar',
		text: 'Follow every competition in the world, live and coming up.',
	},
];

const features = [
	{
		title: 'Real qualifying routes',
		text: 'World Cup qualifying for every confederation, including the UEFA play-offs through the Nations League and the inter-confederation play-off.',
	},
	{
		title: 'Continental and regional cups',
		text: 'Euro, Copa América, AFCON, Asian Cup, Gold Cup, OFC Nations Cup, the Nations Leagues, Finalissima, Arab Cup, Gulf Cup, ASEAN, SAFF, COSAFA and more.',
	},
	{
		title: 'Draws you can watch',
		text: 'Pots, confederation limits and hosts, drawn live pot by pot, with placeholders for places still to be decided.',
	},
	{
		title: 'Your job on the line',
		text: 'Board objectives for every competition and a confidence meter that results move. Lose it and you’re sacked, or take an offer from another federation.',
	},
	{
		title: 'A world that keeps going',
		text: 'Players develop, decline and retire, new talent comes through each January, and hosts are announced years ahead.',
	},
	{
		title: 'Ranking and history',
		text: 'A live FIFA ranking, honours for every competition, nation profiles and an inbox with the latest news.',
	},
];
---

<Layout
	title="Invictus National Manager: manage any national football team"
	description="Take charge of any of the 211 FIFA nations. Call up your squad, set your tactics and lead your country through qualifiers, continental cups and the World Cup."
	favicon="/national-manager/favicon.svg"
	image="/national-manager/logo.png"
	current="national-manager"
>
	<section class="hero">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<p class="app-id">
					<img src="/national-manager/logo.png" alt="" width="40" height="40" />
					Invictus National Manager
				</p>
				<h1 class="display">Take your country to the World Cup.</h1>
				<p class="lead">
					Manage any of the 211 FIFA nations through qualifiers, continental cups and World Cups, starting on the real
					2026 calendar.
				</p>
				<div class="actions">
					<PlayButton soon />
					<a class="btn btn-secondary" href={webAppUrl}>Play in your browser</a>
				</div>
				<p class="note">Three save slots, stored on your device. No account needed.</p>
			</div>
			<div class="hero-phones">
				<Phone
					class="phone-front"
					src="/national-manager/screen-home.webp"
					alt="Home screen with the FIFA ranking, federation confidence and the next match"
					eager
				/>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="journey-title">
		<div class="wrap">
			<div class="section-head">
				<h2 class="h2" id="journey-title">From call-up to final whistle</h2>
				<p class="lead">Every international window follows the same rhythm.</p>
			</div>
			<ol class="cols cols-4 steps">
				{
					journey.map((j) => (
						<li>
							<h3>{j.title}</h3>
							<p>{j.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section" aria-labelledby="screens-title">
		<div class="wrap">
			<div class="section-head">
				<h2 class="h2" id="screens-title">Built for your phone</h2>
				<p class="strip-hint">Swipe to see more.</p>
			</div>
			<ul class="strip">
				{
					screens.map((s) => (
						<li>
							<Phone src={s.src} />
							<div>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="features-title">
		<div class="wrap">
			<div class="section-head">
				<h2 class="h2" id="features-title">The whole international game</h2>
				<p class="lead">
					Your career starts on 1 September 2026. Every edition after that follows the same rules, so 2040 plays like 2028.
				</p>
			</div>
			<dl class="features">
				{
					features.map((f) => (
						<div>
							<dt>{f.title}</dt>
							<dd>{f.text}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-title">
		<div class="wrap">
			<h2 class="display" id="closing-title">Coming soon to Android.</h2>
			<div class="actions">
				<PlayButton soon />
				<a class="btn btn-secondary" href={webAppUrl}>Play in your browser</a>
			</div>
		</div>
	</section>

	<MoreApps
		name="Invictus Tournament Maker"
		text="Build and run your own football tournaments, leagues and brackets. Free on Google Play."
		href="/"
		logo="/favicon.svg"
	/>
</Layout>
