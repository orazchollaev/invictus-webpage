---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import MoreApps from '../components/MoreApps.astro';

const journey = [
	{
		title: 'Pick any nation',
		text: 'All 211 FIFA members are open to you, from Spain to San Marino, seeded from the real FIFA ranking and each with its own pool of players.',
	},
	{
		title: 'Call up your squad',
		text: 'Name a squad for every international window and tournament, or let your assistant pick it. Injuries, form and suspensions all count.',
	},
	{
		title: 'Set your tactics',
		text: 'Choose from ten formations, pick your eleven on the pitch and set mentality, tempo and pressing for each match.',
	},
	{
		title: 'Play every minute',
		text: 'Follow matches live in text commentary with shots, xG, cards, injuries and substitutions, then extra time and kick-by-kick shootouts.',
	},
];

const screens = [
	{
		src: '/national-manager/screen-nations.webp',
		title: 'Every FIFA member',
		text: 'Choose your nation by confederation, sorted by world ranking.',
	},
	{
		src: '/national-manager/screen-tactics.webp',
		title: 'Your eleven, your way',
		text: 'Line up your players in ten formations, or let Best XI suggest a side.',
	},
	{
		src: '/national-manager/screen-comps.webp',
		title: 'A full international calendar',
		text: 'Follow every competition in the world, live and coming up.',
	},
];

const features = [
	{
		title: 'Real qualifying routes',
		text: 'World Cup qualifying for every confederation, including the UEFA play-offs through the Nations League and the inter-confederation play-off.',
	},
	{
		title: 'Continental and regional cups',
		text: 'Euro, Copa América, AFCON, Asian Cup, Gold Cup, OFC Nations Cup, the Nations Leagues, the Finalissima, Arab Cup, Gulf Cup, ASEAN, SAFF, COSAFA and more.',
	},
	{
		title: 'Draws you can watch',
		text: 'Pots, confederation limits and hosts, drawn live pot by pot, with placeholders for the places still being decided.',
	},
	{
		title: 'Your job on the line',
		text: 'Board objectives for every competition, a confidence meter that results move, the sack when it runs out, and offers from other federations.',
	},
	{
		title: 'A world that keeps going',
		text: 'Players develop, decline and retire, youngsters come through each January, federations grow, and hosts are announced years ahead.',
	},
	{
		title: 'Ranking and history',
		text: 'A live FIFA ranking, honours for every competition, nation profiles and an inbox with the latest news.',
	},
];
---

<Layout
	title="Invictus - National Manager"
	description="Invictus National Manager — take charge of any of the 211 FIFA nations, call up your squad, set your tactics and lead them through qualifiers, continental cups and the World Cup."
	favicon="/national-manager/favicon.svg"
	image="/national-manager/logo.png"
>
	<SiteNav current="national-manager" />

	<main class="hero">
		<div class="panel panel-primary">
			<div class="panel-primary-content">
				<p class="description">
					Invictus National Manager <br /> take charge of your country and lead it through qualifiers, continental cups
					and the World Cup.
				</p>
				<span class="cta cta-soon">
					<img src="/google-play-store-icon.webp" alt="" width="20" height="20" />
					<span>
						<small>Coming soon</small>
						Google Play
					</span>
				</span>
			</div>
		</div>

		<div class="panel panel-brand">
			<div class="brand-row">
				<img class="brand-mark" src="/national-manager/logo.png" alt="" />
				<h1>Invictus <span>National Manager</span></h1>
			</div>
			<img
				class="phone-shot"
				src="/national-manager/screen-home.webp"
				alt="National Manager home screen with the FIFA ranking, federation confidence and the next match"
				width="600"
				height="1298"
			/>
		</div>
	</main>

	<section class="section">
		<h2>From call-up to final whistle</h2>
		<div class="grid grid-4">
			{
				journey.map((j) => (
					<div class="card">
						<h3>{j.title}</h3>
						<p>{j.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section section-alt">
		<h2>Built for your phone</h2>
		<div class="screens">
			{
				screens.map((s) => (
					<figure>
						<img class="phone-shot" src={s.src} alt="" width="600" height="1298" loading="lazy" />
						<figcaption>
							<strong>{s.title}</strong>
							{s.text}
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="section">
		<h2>The whole international game</h2>
		<p class="section-lead">
			The career starts on 1 September 2026 on the real FIFA calendar, and every edition after that is played by the same
			rules, so 2040 plays like 2028.
		</p>
		<div class="grid grid-3">
			{
				features.map((f) => (
					<div class="card card-compact">
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section section-alt cta-section">
		<h2>Coming soon to Android</h2>
		<p class="cta-text">Three save slots, stored on your device. No account needed.</p>
		<span class="cta cta-large cta-soon">
			<img src="/google-play-store-icon.webp" alt="" width="22" height="22" />
			Coming soon to Google Play
		</span>
	</section>

	<MoreApps
		name="Invictus Tournament Maker"
		text="Build and run your own football tournaments, leagues and knockout brackets. Free on Google Play."
		href="/"
		logo="/favicon.svg"
	/>

	<footer class="footer">
		<span>Invictus National Manager</span>
		<span>&copy; {new Date().getFullYear()}</span>
	</footer>
</Layout>
